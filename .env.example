# Backend (.env) — copy to .env and fill in. Never commit .env.
#
# Browser sessions: Steel cloud Chromium + Stagehand (liveUrl over Socket.IO).
# Demos navigate public websites. Internal/private hosts stay blocked.

OPENAI_API_KEY=
# One model for agent + planner + Stagehand (Stagehand gets openai/<id> automatically)
OPENAI_MODEL=gpt-5.6-luna
# Optional: minimal | low | medium | high | none (model-dependent; Luna defaults to none for tool calls)
# OPENAI_REASONING_EFFORT=none

# Optional: let users run jobs on their own OpenAI or Gemini key (never stored server-side).
# Model lists are comma-separated allowlists; an empty list hides that provider.
# Gemini models must also be supported by Stagehand (google/<model>).
BYOK_ENABLED=false
BYOK_OPENAI_MODELS=gpt-5-mini,gpt-4.1-mini
BYOK_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# BYOK_VERIFY_TIMEOUT_MS=10000
# MAX_KEY_CHECKS_PER_MINUTE=10

STEEL_API_KEY=
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# PostgreSQL (TypeORM) — matches docker-compose postgres service
DATABASE_URL=postgresql://minerva:minerva@localhost:5432/minerva_agent
# Production: run migrations (do not rely on synchronize)
# npm run migration:run

# Optional RAG (tax_code_delta) — Pinecone + OpenAI embeddings (same OPENAI_API_KEY)
PINECONE_API_KEY=
PINECONE_INDEX=
# Must match the index dimension (text-embedding-3-small supports up to 1536)
# PINECONE_DIMENSION=1536

# Security — public web by default (SSRF/internal hosts still blocked).
URL_POLICY_MODE=public
URL_ALLOWLIST=
MAX_SESSIONS_PER_IP=5
MAX_ACTIONS_PER_SESSION=100

# Optional: secure OAuth for Shopify/Stripe/Gmail/Drive via Composio.
COMPOSIO_API_KEY=
# Composio user ids are "<prefix><account id>", so each signed-in user has their own connections.
# COMPOSIO_USER_ID_PREFIX=minerva:
# Shopify has no Composio-managed OAuth app. Create a Shopify app, add an auth config
# for the shopify toolkit in the Composio dashboard, and paste its id (ac_...).
COMPOSIO_SHOPIFY_AUTH_CONFIG_ID=
# Where the OAuth popup returns (web route). Defaults to FRONTEND_URL/app/connected.
# COMPOSIO_CALLBACK_URL=

# Gateway Socket.IO auth (required in production)
GATEWAY_API_KEY=
TRUST_PROXY=false

# User accounts (Clerk). Issuer = your Clerk Frontend API URL.
AUTH_ISSUER=
# AUTH_JWKS_URL=   (defaults to <AUTH_ISSUER>/.well-known/jwks.json)
# AUTH_AUDIENCE=
