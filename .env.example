# Backend (.env) — copy to .env and fill in. Never commit .env.
#
# Browser sessions: ALWAYS Browserbase (cloud Chromium + liveUrl).
# Do not run the agent in local Chromium for the demo path.
# Primary demo navigates allowlisted public sites (IRS.gov for Tax Delta).

BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# PostgreSQL (TypeORM)
DATABASE_URL=postgresql://user:pass@localhost:5432/minerva_agent
# Production: run migrations (do not rely on synchronize)
# npm run migration:run
# Or discrete vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=minerva
# DB_PASSWORD=
# DB_NAME=minerva_agent

# Redis (live sessions / approvals)
REDIS_URL=redis://localhost:6379
# Or:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
SESSION_TTL_SECONDS=3600

# Security — navigation allowlist (Tax Delta uses IRS.gov)
URL_ALLOWLIST=irs.gov,www.irs.gov
MAX_SESSIONS_PER_IP=5
MAX_ACTIONS_PER_SESSION=100
